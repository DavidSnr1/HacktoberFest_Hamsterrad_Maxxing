NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:migrate` (Session pooler connection string incl. password)
SUPABASE_DB_URL=
GEMINI_API_KEY=
LLM_MODEL_LIVE=gemma-4-26b-a4b-it
LLM_MODEL_QUALITY=gemma-4-31b-it
ELEVENLABS_API_KEY=
# Optional: voice of the interviewer (default: a premade ElevenLabs voice)
ELEVENLABS_VOICE_ID=
# Optional: D-ID key for the talking-head videos of the interviewer (npm run videos:generate)
DID_API_KEY=

# --- Feature C – Stellen-Scraper ---
# LinkedIn/Indeed/StepStone-Adapter (siehe docs/handoff/job-scraper.md). Standard: an, false schaltet sie ab.
JOBS_ENABLE_SCRAPED_SOURCES=true
# Nur für Demos: Beispielstellen sehen aus wie normale Indeed-Treffer. Vor einem Livegang auf false.
JOBS_DEMO_MODE=false
# Indeed blockiert fast immer; dann zeigt der Tab Beispielstellen (als „Beispiel“ markiert) und füllt auf mind. 10 Treffer auf. false: beides aus.
JOBS_INDEED_MOCK=true
# Optional: Adzuna API (https://developer.adzuna.com), kostenloser Key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Lokal: Direktanmeldung ohne Magic-Link-Mail (nur npm run dev), kommagetrennte Adressen ---
DEV_LOGIN_EMAILS=
